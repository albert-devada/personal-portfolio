# ==============================================================================
# Application & Environment Configuration
# ==============================================================================
NEXT_PUBLIC_APP_NAME="Portfolio"
APP_KEYS="YOUR_ENCRYPTION_KEY" # Secret key for encrypting client session data
NODE_ENV="development"  # Runtime environment ("development" | "production")

# ==============================================================================
# Domain & API Routing URLs
# ==============================================================================
NEXT_PUBLIC_WEB_URL="http://localhost:3000" # Public web application base URL
NEXT_PUBLIC_API_URL="http://api.localhost:3000" # Dedicated API subdomain or base endpoint URL

# ==============================================================================
# AI Assistant Service (Google Gemini)
# Obtain your API key from Google AI Studio (https://aistudio.google.com)
# ==============================================================================
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ==============================================================================
# Database & Backend Integration (Supabase)
# Project credentials available in your Supabase dashboard (https://supabase.com)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# ==============================================================================
# Bot Protection & Captcha Verification (Cloudflare Turnstile)
# Widget keys from Cloudflare Dashboard (https://dash.cloudflare.com)
# ==============================================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY="YOUR_TURNSTILE_SITE_KEY"
TURNSTILE_SECRET_KEY="YOUR_TURNSTILE_SECRET_KEY"

# ==============================================================================
# Client Geolocation & Network Telemetry
# You can integrate your own preferred IP Geolocation
# ==============================================================================
GEOLOCATION_API_URL="YOUR_API_URL"